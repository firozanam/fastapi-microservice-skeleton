# Application Settings
APP_NAME=microservice-api
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8080
WORKERS=4

# ============================================================================
# DATABASE ENABLE FLAGS (Modular Configuration)
# ============================================================================
# Control which databases are initialized and available for your service.
# Set to 'false' to disable unused databases and reduce overhead.
#
# DEFAULT PROFILE (All Databases Enabled):
ENABLE_POSTGRES=true
ENABLE_MONGODB=true
ENABLE_REDIS=true
#
# EXAMPLE CONFIGURATION PROFILES:
# ============================================================================
# 
# Profile 1 - Relational + Cache (PostgreSQL + Redis):
#   ENABLE_POSTGRES=true
#   ENABLE_MONGODB=false
#   ENABLE_REDIS=true
#   Use case: Services requiring structured data with caching
#
# Profile 2 - Relational Only (PostgreSQL):
#   ENABLE_POSTGRES=true
#   ENABLE_MONGODB=false
#   ENABLE_REDIS=false
#   Use case: Services requiring only structured data without caching
#
# Profile 3 - Document + Cache (MongoDB + Redis):
#   ENABLE_POSTGRES=false
#   ENABLE_MONGODB=true
#   ENABLE_REDIS=true
#   Use case: Services requiring flexible schemas with caching
#
# Profile 4 - Cache Only (Redis):
#   ENABLE_POSTGRES=false
#   ENABLE_MONGODB=false
#   ENABLE_REDIS=true
#   Use case: Services requiring only caching/session storage
#
# Profile 5 - All Databases (PostgreSQL + MongoDB + Redis):
#   ENABLE_POSTGRES=true
#   ENABLE_MONGODB=true
#   ENABLE_REDIS=true
#   Use case: Services requiring multiple data storage paradigms
#
# ============================================================================

# Database - PostgreSQL
# Only required if ENABLE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=microservice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# Database - MongoDB
# Only required if ENABLE_MONGODB=true
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=microservice_db
MONGODB_USER=mongo
MONGODB_PASSWORD=mongo

# Cache - Redis
# Only required if ENABLE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_TTL=3600

# Message Queue - Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=microservice-group
KAFKA_TOPICS=events,notifications,tasks

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Security
SECURITY_BCRYPT_ROUNDS=12
SECURITY_OTP_LENGTH=6
SECURITY_OTP_EXPIRE_MINUTES=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# Monitoring & Observability
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
TRACING_ENABLED=False
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# External Services (Example placeholders - replace with your actual service URLs)
SERVICE_A_URL=http://service-a:8080
SERVICE_B_URL=http://service-b:8080
SERVICE_C_URL=http://service-c:8080

# CDN Settings
CDN_BASE_URL=https://cdn.example.com
CDN_CACHE_TTL=300

# DRM Settings
DRM_WIDEVINE_URL=https://drm.example.com/widevine
DRM_FAIRPLAY_URL=https://drm.example.com/fairplay
DRM_PLAYREADY_URL=https://drm.example.com/playready

# Email Settings (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=My Service

# SMS Settings (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Feature Flags (Example flags - customize for your service)
FEATURE_REGISTRATION_ENABLED=True
FEATURE_SOCIAL_LOGIN_ENABLED=True
FEATURE_2FA_ENABLED=True
FEATURE_API_DOCS_ENABLED=True
FEATURE_METRICS_ENABLED=True

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
